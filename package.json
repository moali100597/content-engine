{
  "name": "content-engine",
  "version": "1.0.0",
  "description": "An open motion-graphics and video-editing engine on Remotion: explainers driven by a voice-over, footage cuts, design stills, a 3D studio, and the tools around them (soundtrack, captions, footage analysis, Google generation). Arabic-first, RTL-ready.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "still": "remotion still src/index.ts",
    "stills": "node tools/stills.mjs",
    "qa": "node qa.mjs",
    "gen": "node tools/gen.mjs",
    "new": "node tools/new-video.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "remotion",
    "video",
    "motion-graphics",
    "react",
    "arabic",
    "rtl",
    "video-editing"
  ],
